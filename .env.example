# ===========================================
# Code-2-Doc Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# AWS Bedrock Configuration
# ===========================================
AWS_REGION=us-east-1

# LOCAL DEVELOPMENT: Use AWS CLI profile
# Configure profile with: aws configure --profile your-profile-name
AWS_PROFILE=your-profile-name

# DEPLOYMENT: Use IAM role (no credentials needed)
# The application will automatically use the IAM role attached to the compute resource
# Leave AWS_PROFILE empty or unset when using IAM roles

# Bedrock Model Configuration
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ===========================================
# LLM Provider Selection
# ===========================================
# LLM Provider: "bedrock" (default) or "anthropic"
LLM_PROVIDER=bedrock

# Option B: Direct Anthropic API (alternative to Bedrock)
# Uncomment and set if using Anthropic directly instead of Bedrock
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ===========================================
# LangSmith Tracing (Optional)
# ===========================================
# Enable for debugging and monitoring agent behavior
# Sign up at https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=ls__xxxxxxxxxxxx
# LANGCHAIN_PROJECT=code2doc

# ===========================================
# GitLab Configuration
# ===========================================
GITLAB_URL=https://gitlab.example.com
GITLAB_GROUP=company
GITLAB_ACCESS_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ===========================================
# Confluence Configuration
# ===========================================
CONFLUENCE_URL=https://example.atlassian.net/wiki
CONFLUENCE_USERNAME=user@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=DOCS

# Optional: Parent page ID for documentation hierarchy
CONFLUENCE_PARENT_PAGE_ID=

# ===========================================
# Application Settings
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Default project name (overrides auto-detection from repo)
# PROJECT_NAME=MyProject
